# Local Terraform directories
**/.terraform/*

# Terraform state
**/*.tfstate
**/*.tfstate.*

# Secrets
**/*.tfvars
**/*.env

# Local backups
terraform-state-backup-before-cloudflare-cleanup.json
terraform/state-backup-*.json

# Allow committing this one non-secret tfvars file for CI/CD
!terraform/terraform.auto.tfvars
